^SAMPLE = GSM8864696
!Sample_title = HCM2
!Sample_geo_accession = GSM8864696
!Sample_status = Public on Apr 15 2026
!Sample_submission_date = Mar 24 2025
!Sample_last_update_date = Apr 15 2026
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Heart left ventricle
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: Heart left ventricle
!Sample_characteristics_ch1 = cell type: Cardiac cells
!Sample_characteristics_ch1 = Sex: female
!Sample_characteristics_ch1 = age: 14
!Sample_characteristics_ch1 = patient id: P186
!Sample_molecule_ch1 = nuclear RNA
!Sample_extract_protocol_ch1 = Cardiac tissue was collected from the LV free wall in the operating room at time of transplant. The sample was kept in cold saline on ice during transfer to the laboratory for preservation. It was carefully dissected into multiple aliquots, which were flash-frozen and stored at –80 °C. Nuclear isolation was performed. Briefly, frozen cardiac tissue was dissociated by using a Dounce homogenizer. Single nuclei were isolated via fluorescence-activated cell sorting.
!Sample_extract_protocol_ch1 = SnRNA-seq was performed by using the 10X Genomics platform. Isolated nuclei were loaded into the 10X Genomics Chromium Controller to obtain the gel beads in emulsion. The sequencing libraries were then prepared according to the manufacturer’s protocols for the Single-cell 3’ Reagents Kits v3. Sequencing was performed by using the NovaSeq 6000 system.
!Sample_description = Library name: 2023_Pediatric1_DTuraga_P186
!Sample_description = LV tissue from end stage P186 HCM heart at time of transplant, profiled by 10X Genomics 3'v3 snRNA-seq
!Sample_data_processing = Raw sequencing reads were aligned to the genome (build GRCh38) using the 10X Genomics toolkit CellRanger version 5.0.1 (cellranger count) with default parameters.
!Sample_data_processing = Assembly: GRCh38
!Sample_data_processing = Supplementary files format and content: TSV files: Tab-separated tables. MTX files: long-format matrix files. CSV files: comma-seperated tables.
!Sample_platform_id = GPL24676
